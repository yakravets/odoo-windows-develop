{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Attach to Odoo in Docker",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5555
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/addons",
          "remoteRoot": "/mnt/extra-addons"
        }
      ]
    }
  ]
}
